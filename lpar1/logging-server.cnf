[ req ]
default_bits = 2048
default_md = sha256
prompt = no
encrypt_key = no
distinguished_name = dn


[ logging-server ]
subjectAltName = DNS:logging.control12.${ENV::DOMAIN},IP:192.168.0.1
extendedKeyUsage = serverAuth

[ dn ]
O = vault
OU = oso
CN = 192.168.0.1
#CN = logging.control12.${ENV::DOMAIN}
