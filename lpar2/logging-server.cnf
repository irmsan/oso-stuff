[ req ]
default_bits = 2048
default_md = sha256
prompt = no
encrypt_key = no
distinguished_name = dn

[ logging-server ]
subjectAltName = DNS:logging.control23.${ENV::DOMAIN},IP:192.168.64.2
extendedKeyUsage = serverAuth

[ dn ]
O = vault
OU = oso
CN = 192.168.64.2
#CN = logging.control23.${ENV::DOMAIN}

